    <main>
        <h1>crear producto</h1>
        <section class="createProduct-Container">
            <form id="altaProducts-container">
                <input type="hidden" name="id" value="${p.id}">
                <label for="nameProd">Name</label>
                <input type="text" name="name" id="nameProd" required>

                <label for="imageProd">Image</label>
                <input type="text" name="image" id="imageProd" required>

                <label for="priceProd">Price</label>
                <input type="number" name="price" id="priceProd" required>

                <label for="imageProd">Select Category :</label>
                <select name="category" id="categoryProd">
                    <option value="auriculares">Auriculares</option>
                    <option value="iphod's">Iphod</option>
                </select>

                <input type="submit" value="create product">
            </form>

            <article class="product-list"> </article>

            <div class="createUser">
                <h1>Crear Usuario</h1>
                <form autocomplete="off"  id="altaUser-form" >
    
                    <label for="nameUser">Name</label>
                    <input type="text" name="name" id="nameUser" required>
    
                    <label for="emailUser">Email</label>
                    <input type="email" name="email" id="emailUser" required>
    
                    <label for="passwordUser">Password</label>
                    <input type="password" name="password" id="passwordUser" required>
    
                    <input type="submit" value="Crear Usuario">
                </form>
            </div>
        </section>
        <script src="js/create.js"></script>